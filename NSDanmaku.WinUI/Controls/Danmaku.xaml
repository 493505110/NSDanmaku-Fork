<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NSDanmaku.WinUI.Controls.Danmaku"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NSDanmaku.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="mainContainer" local:DanmakuExtensions.ClipToBounds="True">
        <Canvas x:Name="danmakuCanvas" />
        <Grid x:Name="scrollContainer" />
        <Grid x:Name="topContainer" />
        <Grid x:Name="bottomContainer" />
    </Grid>
</UserControl>
